NODE_ENV=development
PORT=4000

# Local PostgreSQL + TimescaleDB. Homebrew has no "postgres" role by default: run `createuser -s postgres` once
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=rock_shield
DB_SSL=false

# ML service (ai-ml/ml-service/main.py listens on 8001 by default)
AI_BASE_URL=http://localhost:8001

