NODE_ENV=development
PORT=4000

# PostgreSQL + TimescaleDB (or set DATABASE_URL instead)
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=rock_shield
DB_SSL=false

# ML service (ai-ml/ml-service/main.py listens on 8001 by default)
AI_BASE_URL=http://localhost:8001

# Clerk auth - from https://dashboard.clerk.com
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: instance PEM public key (Clerk dashboard > API keys > JWT public key), wrapped in double quotes
CLERK_JWT_KEY=

# Test logins seeded into Clerk + the users table on backend start (see src/db/seedTestAccounts.js)
# Verification code for +clerk_test emails is always 424242
SEED_TEST_ACCOUNTS=true
TEST_ADMIN_USERNAME=test_admin
TEST_ADMIN_EMAIL=admin+clerk_test@example.com
TEST_ADMIN_PASSWORD=
TEST_OPERATOR_USERNAME=test_operator
TEST_OPERATOR_EMAIL=operator+clerk_test@example.com
TEST_OPERATOR_PASSWORD=
TEST_MINER_USERNAME=test_miner
TEST_MINER_EMAIL=miner+clerk_test@example.com
TEST_MINER_PASSWORD=

# OpenTopography API key (terrain features) - https://portal.opentopography.org
DEM_API_KEY=
WEATHER_API_KEY=

# Optional: alert notifications
ENABLE_ALERT_NOTIFICATIONS=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ALERT_SMS_RECIPIENTS=
ALERT_VOICE_RECIPIENTS=
ALERT_EMAIL_RECIPIENTS=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
